-- -----------------------------------------------------
-- Esquema de Base de Datos: bd_cocina_virtual_norm
-- Autor: IA Generada
-- Descripción: Estructura normalizada para gestión de Dark Kitchens
-- -----------------------------------------------------

CREATE SCHEMA IF NOT EXISTS `bd_cocina_virtual_norm` DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE `bd_cocina_virtual_norm`;

-- -----------------------------------------------------
-- Tabla: ESTADO (Catálogo Centralizado)
-- -----------------------------------------------------
CREATE TABLE IF NOT EXISTS `ESTADO` (
  `codigo` CHAR(2) NOT NULL COMMENT 'Ej: AC=Activo, IN=Inactivo, PE=Pendiente, PR=Preparando, EN=En Ruta, TR=Entregado',
  `nombre` VARCHAR(20) NOT NULL,
  PRIMARY KEY (`codigo`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Catálogo maestro de estados para todas las entidades';

-- -----------------------------------------------------
-- Tabla: PLATAFORMA (Catálogo Centralizado)
-- -----------------------------------------------------
CREATE TABLE IF NOT EXISTS `PLATAFORMA` (
  `codigo` CHAR(2) NOT NULL COMMENT 'Ej: TF=Teléfono, UE=UberEats, RP=Rappi',
  `nombre` VARCHAR(50) NOT NULL,
  PRIMARY KEY (`codigo`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Catálogo de plataformas de origen de pedidos';

-- -----------------------------------------------------
-- Tabla: UNIDAD_MEDIDA (Catálogo Centralizado)
-- -----------------------------------------------------
CREATE TABLE IF NOT EXISTS `UNIDAD_MEDIDA` (
  `codigo` CHAR(2) NOT NULL COMMENT 'Ej: GR=Gramos, ML=Mililitros, UN=Unidad',
  `nombre` VARCHAR(50) NOT NULL,
  PRIMARY KEY (`codigo`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Catálogo de unidades de medida para insumos';

-- -----------------------------------------------------
-- Tabla: CATEGORIA (Catálogo para Platillos)
-- -----------------------------------------------------
CREATE TABLE IF NOT EXISTS `CATEGORIA` (
  `codigo` CHAR(2) NOT NULL COMMENT 'Ej: HB=Hamburguesas, AL=Alitas, BE=Bebidas',
  `nombre` VARCHAR(50) NOT NULL,
  PRIMARY KEY (`codigo`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Categorías de menú para los platillos';

-- -----------------------------------------------------
-- Tabla: RESTAURANTE (La marca virtual)
-- -----------------------------------------------------
CREATE TABLE IF NOT EXISTS `RESTAURANTE` (
  `id_restaurante` INT NOT NULL AUTO_INCREMENT,
  `nombre` VARCHAR(100) NOT NULL,
  `codigo_estado` CHAR(2) NOT NULL DEFAULT 'AC',
  PRIMARY KEY (`id_restaurante`),
  INDEX `fk_restaurante_estado_idx` (`codigo_estado` ASC),
  CONSTRAINT `fk_restaurante_estado`
    FOREIGN KEY (`codigo_estado`)
    REFERENCES `ESTADO` (`codigo`)
    ON DELETE NO ACTION
    ON UPDATE NO ACTION
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- -----------------------------------------------------
-- Tabla: REPARTIDOR
-- -----------------------------------------------------
CREATE TABLE IF NOT EXISTS `REPARTIDOR` (
  `id_repartidor` BIGINT NOT NULL AUTO_INCREMENT,
  `nombre_completo` VARCHAR(150) NOT NULL,
  `telefono` CHAR(10) NOT NULL,
  `codigo_estado` CHAR(2) NOT NULL DEFAULT 'AC',
  PRIMARY KEY (`id_repartidor`),
  INDEX `fk_repartidor_estado_idx` (`codigo_estado` ASC),
  CONSTRAINT `fk_repartidor_estado`
    FOREIGN KEY (`codigo_estado`)
    REFERENCES `ESTADO` (`codigo`)
    ON DELETE NO ACTION
    ON UPDATE NO ACTION
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- -----------------------------------------------------
-- Tabla: INSUMO (Inventario de cocina)
-- -----------------------------------------------------
CREATE TABLE IF NOT EXISTS `INSUMO` (
  `id_insumo` INT NOT NULL AUTO_INCREMENT,
  `nombre` VARCHAR(100) NOT NULL,
  `codigo_unidad_medida` CHAR(2) NOT NULL COMMENT 'Unidad base de gestión del insumo',
  `stock_actual` DECIMAL(10, 2) NOT NULL DEFAULT 0.00 COMMENT 'Cantidad disponible',
  `costo_inventario` DECIMAL(10, 2) NOT NULL DEFAULT 0.00 COMMENT 'Costo por unidad de medida',
  `codigo_estado` CHAR(2) NOT NULL DEFAULT 'AC',
  PRIMARY KEY (`id_insumo`),
  INDEX `fk_insumo_unidad_idx` (`codigo_unidad_medida` ASC),
  INDEX `fk_insumo_estado_idx` (`codigo_estado` ASC),
  CONSTRAINT `fk_insumo_unidad`
    FOREIGN KEY (`codigo_unidad_medida`)
    REFERENCES `UNIDAD_MEDIDA` (`codigo`)
    ON DELETE NO ACTION
    ON UPDATE NO ACTION,
  CONSTRAINT `fk_insumo_estado`
    FOREIGN KEY (`codigo_estado`)
    REFERENCES `ESTADO` (`codigo`)
    ON DELETE NO ACTION
    ON UPDATE NO ACTION
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- -----------------------------------------------------
-- Tabla: PLATILLO (Ítem del menú)
-- -----------------------------------------------------
CREATE TABLE IF NOT EXISTS `PLATILLO` (
  `id_platillo` INT NOT NULL AUTO_INCREMENT,
  `id_restaurante` INT NOT NULL COMMENT 'Dueño del platillo',
  `nombre` VARCHAR(150) NOT NULL,
  `costo_venta` DECIMAL(10, 2) NOT NULL DEFAULT 0.00,
  `codigo_categoria` CHAR(2) NOT NULL,
  `codigo_estado` CHAR(2) NOT NULL DEFAULT 'AC',
  PRIMARY KEY (`id_platillo`),
  INDEX `fk_platillo_restaurante_idx` (`id_restaurante` ASC),
  INDEX `fk_platillo_categoria_idx` (`codigo_categoria` ASC),
  INDEX `fk_platillo_estado_idx` (`codigo_estado` ASC),
  CONSTRAINT `fk_platillo_restaurante`
    FOREIGN KEY (`id_restaurante`)
    REFERENCES `RESTAURANTE` (`id_restaurante`)
    ON DELETE NO ACTION
    ON UPDATE NO ACTION,
  CONSTRAINT `fk_platillo_categoria`
    FOREIGN KEY (`codigo_categoria`)
    REFERENCES `CATEGORIA` (`codigo`)
    ON DELETE NO ACTION
    ON UPDATE NO ACTION,
  CONSTRAINT `fk_platillo_estado`
    FOREIGN KEY (`codigo_estado`)
    REFERENCES `ESTADO` (`codigo`)
    ON DELETE NO ACTION
    ON UPDATE NO ACTION
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- -----------------------------------------------------
-- Tabla: RECETA (Composición del platillo)
-- -----------------------------------------------------
CREATE TABLE IF NOT EXISTS `RECETA` (
  `id_platillo` INT NOT NULL,
  `id_insumo` INT NOT NULL,
  `cantidad_requerida` DECIMAL(10, 2) NOT NULL DEFAULT 1.00 COMMENT 'Cantidad del insumo por 1 unidad de platillo',
  PRIMARY KEY (`id_platillo`, `id_insumo`),
  INDEX `fk_receta_insumo_idx` (`id_insumo` ASC),
  CONSTRAINT `fk_receta_platillo`
    FOREIGN KEY (`id_platillo`)
    REFERENCES `PLATILLO` (`id_platillo`)
    ON DELETE NO ACTION
    ON UPDATE NO ACTION,
  CONSTRAINT `fk_receta_insumo`
    FOREIGN KEY (`id_insumo`)
    REFERENCES `INSUMO` (`id_insumo`)
    ON DELETE NO ACTION
    ON UPDATE NO ACTION
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Tabla intermedia M:N para definir ingredientes';

-- -----------------------------------------------------
-- Tabla: PEDIDO (Transacción principal)
-- -----------------------------------------------------
CREATE TABLE IF NOT EXISTS `PEDIDO` (
  `id_pedido` BIGINT NOT NULL AUTO_INCREMENT,
  `codigo_plataforma` CHAR(2) NOT NULL,
  `codigo_estado` CHAR(2) NOT NULL DEFAULT 'PE' COMMENT 'Estado actual del pedido global',
  `hora_solicitud` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `hora_aceptado` DATETIME NULL,
  `hora_entrega` DATETIME NULL COMMENT 'Hora final de entrega por repartidor',
  PRIMARY KEY (`id_pedido`),
  INDEX `fk_pedido_plataforma_idx` (`codigo_plataforma` ASC),
  INDEX `fk_pedido_estado_idx` (`codigo_estado` ASC),
  CONSTRAINT `fk_pedido_plataforma`
    FOREIGN KEY (`codigo_plataforma`)
    REFERENCES `PLATFORMA` (`codigo`)
    ON DELETE NO ACTION
    ON UPDATE NO ACTION,
  CONSTRAINT `fk_pedido_estado`
    FOREIGN KEY (`codigo_estado`)
    REFERENCES `ESTADO` (`codigo`)
    ON DELETE NO ACTION
    ON UPDATE NO ACTION
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- -----------------------------------------------------
-- Tabla: DETALLE_PEDIDO (Ítems solicitados en el pedido)
-- -----------------------------------------------------
CREATE TABLE IF NOT EXISTS `DETALLE_PEDIDO` (
  `id_pedido` BIGINT NOT NULL,
  `id_platillo` INT NOT NULL,
  `cantidad` INT NOT NULL DEFAULT 1,
  PRIMARY KEY (`id_pedido`, `id_platillo`),
  INDEX `fk_detalle_pedido_platillo_idx` (`id_platillo` ASC),
  CONSTRAINT `fk_detalle_pedido_pedido`
    FOREIGN KEY (`id_pedido`)
    REFERENCES `PEDIDO` (`id_pedido`)
    ON DELETE NO ACTION
    ON UPDATE NO ACTION,
  CONSTRAINT `fk_detalle_pedido_platillo`
    FOREIGN KEY (`id_platillo`)
    REFERENCES `PLATILLO` (`id_platillo`)
    ON DELETE NO ACTION
    ON UPDATE NO ACTION
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Relación N:M entre Pedido y Platillo';

-- -----------------------------------------------------
-- Tabla: ASIGNACION_REPARTIDOR
-- -----------------------------------------------------
CREATE TABLE IF NOT EXISTS `ASIGNACION_REPARTIDOR` (
  `folio` INT NOT NULL AUTO_INCREMENT,
  `id_repartidor` BIGINT NOT NULL,
  `id_pedido` BIGINT NOT NULL,
  `hora_salida` DATETIME NULL DEFAULT CURRENT_TIMESTAMP COMMENT 'Hora en que el repartidor recoge el pedido',
  PRIMARY KEY (`folio`),
  UNIQUE INDEX `id_pedido_UNIQUE` (`id_pedido` ASC),
  INDEX `fk_asignacion_repartidor_idx` (`id_repartidor` ASC),
  CONSTRAINT `fk_asignacion_repartidor`
    FOREIGN KEY (`id_repartidor`)
    REFERENCES `REPARTIDOR` (`id_repartidor`)
    ON DELETE NO ACTION
    ON UPDATE NO ACTION,
  CONSTRAINT `fk_asignacion_pedido`
    FOREIGN KEY (`id_pedido`)
    REFERENCES `PEDIDO` (`id_pedido`)
    ON DELETE NO ACTION
    ON UPDATE NO ACTION
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Vincula pedido con repartidor y logística de salida';

-- -----------------------------------------------------
-- Tabla: DETALLE_PEDIDO_INSUMO (DESGLOSE AUTOMÁTICO DE RECETA)
-- Tabla fundamental para la lógica de inventario.
-- Registra el consumo exacto de insumos por cada línea de detalle del pedido.
-- -----------------------------------------------------
CREATE TABLE IF NOT EXISTS `DETALLE_PEDIDO_INSUMO` (
  `id_pedido` BIGINT NOT NULL,
  `id_platillo` INT NOT NULL,
  `id_insumo` INT NOT NULL,
  `cantidad_consumida` DECIMAL(10, 2) NOT NULL COMMENT 'Cantidad restada del inventario',
  PRIMARY KEY (`id_pedido`, `id_platillo`, `id_insumo`),
  INDEX `fk_dpi_insumo_idx` (`id_insumo` ASC),
  -- Esta FK compuesta asegura que el consumo pertenezca a un platillo válido dentro de un pedido
  CONSTRAINT `fk_dpi_pedido_platillo`
    FOREIGN KEY (`id_pedido` , `id_platillo`)
    REFERENCES `DETALLE_PEDIDO` (`id_pedido` , `id_platillo`)
    ON DELETE NO ACTION
    ON UPDATE NO ACTION,
  CONSTRAINT `fk_dpi_insumo`
    FOREIGN KEY (`id_insumo`)
    REFERENCES `INSUMO` (`id_insumo`)
    ON DELETE NO ACTION
    ON UPDATE NO ACTION
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Trazabilidad del consumo de inventario por venta';


